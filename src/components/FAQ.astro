---
/**
 * Renders an accessible FAQ accordion. The matching FAQPage JSON-LD is emitted
 * separately (see Schema usage in layouts) so the same data powers both the
 * visible UI and the rich result. The video requires 4-8 FAQs per page.
 */
interface Props {
  faqs: Array<{ question: string; answer: string }>;
  heading?: string;
}
const { faqs, heading = 'Frequently asked questions' } = Astro.props;
---
{faqs.length > 0 && (
  <section class="faq section" aria-labelledby="faq-heading">
    <div class="container">
      <h2 id="faq-heading">{heading}</h2>
      <div class="faq__list">
        {faqs.map((f) => (
          <details class="faq__item">
            <summary>{f.question}</summary>
            <div class="faq__answer"><p>{f.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .faq__list { display: grid; gap: 0.75rem; max-width: 800px; }
  .faq__item { border: 1px solid var(--border); border-radius: var(--radius); background: #fff; }
  .faq__item summary { cursor: pointer; font-weight: 700; padding: 1rem 1.2rem; list-style: none; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; float: right; color: var(--brand); font-weight: 700; }
  .faq__item[open] summary::after { content: '−'; }
  .faq__answer { padding: 0 1.2rem 1rem; }
  .faq__answer p { margin: 0; color: var(--muted); }
</style>

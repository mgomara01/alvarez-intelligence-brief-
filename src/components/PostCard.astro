---
import { Image } from 'astro:assets';
interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  image?: ImageMetadata;
  imageAlt?: string;
  tags?: string[];
}
const { href, title, description, pubDate, image, imageAlt = '', tags = [] } = Astro.props;
const dateStr = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<article class="card post-card">
  <a href={href} class="post-card__link" aria-label={title}>
    {image && (
      <div class="post-card__media">
        <Image src={image} alt={imageAlt} width={640} height={360} loading="lazy" />
      </div>
    )}
    <div class="post-card__body">
      {tags[0] && <span class="eyebrow">{tags[0]}</span>}
      <h3>{title}</h3>
      <p class="muted">{description}</p>
      <time datetime={pubDate.toISOString()} class="muted post-card__date">{dateStr}</time>
    </div>
  </a>
</article>

<style>
  .post-card { padding: 0; overflow: hidden; }
  .post-card__link { color: inherit; display: block; }
  .post-card__link:hover { text-decoration: none; }
  .post-card__media :global(img) { width: 100%; height: 200px; object-fit: cover; }
  .post-card__body { padding: 1.2rem 1.4rem 1.4rem; }
  .post-card__body h3 { margin: 0.3rem 0 0.4rem; }
  .post-card__date { font-size: 0.85rem; }
</style>

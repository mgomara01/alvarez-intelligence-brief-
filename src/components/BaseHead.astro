---
/**
 * Everything that goes in <head> for SEO: title, description, canonical,
 * Open Graph, Twitter cards, robots directives, GSC verification, and GA4.
 * Every page funnels through here via BaseLayout.
 */
import { SITE } from '../site.config';
import { canonical, ogImageUrl, composeTitle, clampDescription } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  canonicalOverride?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  path,
  image,
  type = 'website',
  noindex = false,
  canonicalOverride,
  publishedTime,
  modifiedTime,
} = Astro.props;

const fullTitle = composeTitle(title);
const desc = clampDescription(description);
const canonicalUrl = canonicalOverride ?? canonical(path);
const ogImg = ogImageUrl(image);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonicalUrl} />

{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : <meta name="robots" content="index, follow, max-image-preview:large" />}

{SITE.googleSiteVerification && (
  <meta name="google-site-verification" content={SITE.googleSiteVerification} />
)}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImg} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={ogImg} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- GA4 (only emitted when configured; loaded async so it never blocks render) -->
{SITE.ga4MeasurementId && (
  <>
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4MeasurementId}`}
    ></script>
    <script is:inline define:vars={{ id: SITE.ga4MeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', id);
    </script>
  </>
)}

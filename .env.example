# ----------------------------------------------------------------------------
# Copy this file to ".env" and fill in your keys. NEVER commit the real .env.
# Everything is OPTIONAL — the content engine runs offline without any keys and
# only "levels up" automation when a key is present.
# ----------------------------------------------------------------------------

# Pexels: free royalty-free images for blog/service pages.
# Get one at https://www.pexels.com/api/  (Images won't auto-fetch without it;
# the generator falls back to local placeholders.)
PEXELS_API_KEY=

# SERP analysis ("steal-the-average" of the top-3 ranking pages).
# Optional. Without it, run `npm run serp:analyze -- <url1> <url2> <url3>`
# and paste the URLs manually. With a key, the tool pulls the top 3 for you.
# Serper.dev is cheap and simple: https://serper.dev/
SERPER_API_KEY=

# Public site URL used for canonical tags, sitemap, and OG images.
# Also read by astro.config via site.config.ts. Set this to your real domain
# before deploying (e.g. https://www.youragency.com).
PUBLIC_SITE_URL=https://example.com
